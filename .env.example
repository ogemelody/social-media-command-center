# CommandOS owner authentication
COMMANDOS_OWNER_EMAIL=owner@example.com
# Generate after dependencies are installed:
# python -m app.core.password_tool "your-password"
COMMANDOS_OWNER_PASSWORD_HASH=
COMMANDOS_SESSION_SECRET=change-me-with-at-least-32-random-characters

# Generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COMMANDOS_TOKEN_ENCRYPTION_KEY=

# Local development database. PostgreSQL is recommended for deployed environments.
COMMANDOS_DATABASE_URL=sqlite:///./commandos.db
COMMANDOS_AUTO_CREATE_SCHEMA=true

# Google OAuth / YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/api/youtube/callback
# Restricted server-side key for public creator metadata and comments.
# In Google Cloud, restrict this key to YouTube Data API v3.
YOUTUBE_API_KEY=

# Browser origin
COMMANDOS_FRONTEND_ORIGIN=http://127.0.0.1:5178
COMMANDOS_SECURE_COOKIES=false

# Lightweight single-owner scheduler. Use a durable worker before multi-instance deployment.
COMMANDOS_SCHEDULED_SYNC_ENABLED=true
COMMANDOS_YOUTUBE_SYNC_INTERVAL_HOURS=24
COMMANDOS_YOUTUBE_SCHEDULER_POLL_SECONDS=60
