# CommandOS owner authentication
COMMANDOS_OWNER_EMAIL=owner@example.com
# Generate after dependencies are installed:
# python -m app.core.password_tool "your-password"
COMMANDOS_OWNER_PASSWORD_HASH=
COMMANDOS_SESSION_SECRET=change-me-with-at-least-32-random-characters

# Generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COMMANDOS_TOKEN_ENCRYPTION_KEY=

# Local development database. PostgreSQL is recommended for deployed environments.
COMMANDOS_DATABASE_URL=sqlite:///./commandos.db
COMMANDOS_AUTO_CREATE_SCHEMA=true

# Google OAuth / YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/youtube/callback

# Browser origin
COMMANDOS_FRONTEND_ORIGIN=http://localhost:5173
COMMANDOS_SECURE_COOKIES=false
